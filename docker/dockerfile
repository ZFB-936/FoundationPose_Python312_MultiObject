FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget git build-essential cmake ninja-build \
    libeigen3-dev libboost-system-dev libboost-program-options-dev \
    libgl1 libglib2.0-0 libxrender1 libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda create -y -n foundationpose python=3.9 \
    && /opt/conda/bin/conda clean -afy

ENV PATH=/opt/conda/envs/foundationpose/bin:/opt/conda/bin:${PATH}
ENV CUDA_HOME=/usr/local/cuda
ENV OPENCV_IO_ENABLE_OPENEXR=1

# Build from the repository root: docker build -f docker/dockerfile -t foundationpose .
COPY requirements.txt /tmp/foundationpose-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/foundationpose-requirements.txt \
    && python -m pip install --no-cache-dir --no-build-isolation git+https://github.com/NVlabs/nvdiffrast.git \
    && rm /tmp/foundationpose-requirements.txt

WORKDIR /workspace/FoundationPose
CMD ["bash"]
